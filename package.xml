<?xml version="1.0"?>
<package format="2">
  <name>vx300s_mujoco_envs</name>
  <version>0.0.1</version>
  <description>
    ViperX-300 S MuJoCo environments (mujoco_ros_pkgs backend) for validating the
    MultiROS MuJoCo backend end-to-end. Mirrors the Gazebo VX300S envs but builds
    each env from the multiros MuJoCo tooling. Provides reach, push, and pick-and-place
    tasks (plus goal-conditioned variants). Available but experimental; part of the
    MuJoCo backend, which is not yet in a stable release.
  </description>
  <maintainer email="j.kapukotuwa@research.ait.ie">Jayasekara Kapukotuwa</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- rospy is find_package()-ed in CMakeLists and re-exported via catkin_package, -->
  <!-- so it must be a full build+exec dependency (catkin enforces this at configure time). -->
  <depend>rospy</depend>

  <!-- Workspace packages providing the backend and the robot description. -->
  <!-- Declared so catkin orders them before this package in the build graph. -->
  <!-- (Task and training configs are now self-contained in this package's config/.) -->
  <exec_depend>multiros</exec_depend>
  <exec_depend>viperx300s_description</exec_depend>

  <!-- Runtime ROS message / TF / kinematics packages used by the env code and launch. -->
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_controller</exec_depend>
  <exec_depend>effort_controllers</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>

  <!-- Source-built / Python-only packages resolved from the workspace, not rosdep: -->
  <!-- mujoco_ros_pkgs (mujoco_ros, mujoco_ros_msgs, mujoco_ros_control), -->
  <!-- sb3_ros_support, uniros. Same rationale as multiros: not available through rosdep. -->

  <export>
  </export>
</package>
