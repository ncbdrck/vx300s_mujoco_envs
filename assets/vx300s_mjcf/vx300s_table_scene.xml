<mujoco model="vx300s table scene">
  <!--
    Shared scene for the MuJoCo backend tasks (reach / push / pnp): the ViperX-300 S arm on a
    table, with the ground plane below.

    Heights: the arm base (vx300s.xml) is at the world origin, so the TABLE TOP is at z = 0 and
    the arm is mounted on it. The table is a realistic shape — a thin top slab plus four legs —
    and the floor plane is dropped to the bottom of the legs (z = -TABLE_H) so the table stands
    on the ground instead of being a box buried in it. Keeping the table top at z = 0 means the
    arm's kinematics, FK, joint limits and reach goal sampling are unchanged; the table only adds
    a physical working surface (objects rest on z = 0).

    Layout: the top is RECTANGULAR and extended toward +x (in front of the arm) so push/pnp have
    a real workspace. The arm stays at the world origin [0,0,0] and sits in the BACK third of the
    table; the front edge reaches x = +0.70, well beyond the reach goal region (x up to ~0.40) so
    a cube can be pushed forward without falling off. Top spans x: -0.30..+0.70 (length 1.0),
    y: -0.40..+0.40; 0.04 thick. Table height TABLE_H = 0.60 m.

    The arm model (vx300s.xml) is the upstream Trossen description with its native MJCF actuators
    removed, since joint commands are applied by mujoco_ros_control.
  -->
  <include file="vx300s.xml"/>

  <statistic center="0.2 0 0.05" extent="0.9"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table" rgba="0.62 0.45 0.30 1.0"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- Ground plane dropped to the foot of the table legs (TABLE_H = 0.60 below the top). -->
    <geom name="floor" pos="0 0 -0.60" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Static table, rectangular and extended toward +x; top face at z = 0, legs to the floor. -->
    <body name="table" pos="0 0 0">
      <!-- Top slab: x in [-0.30, 0.70] (centre 0.20, half 0.50), y in [-0.40, 0.40], 0.04 thick
           (top face at z = 0 -> centre z = -0.02). -->
      <geom name="table_top" type="box" pos="0.20 0 -0.02" size="0.50 0.40 0.02" material="table"
            friction="1.0 0.005 0.0001"/>
      <!-- Legs: 0.06 x 0.06 posts inset 0.04 from the top corners, from just under the slab
           (z = -0.04) to the floor (z = -0.60). Height 0.56 -> half 0.28, centre z = -0.32.
           Front legs at x = 0.66, back legs at x = -0.26; y = +/-0.36. -->
      <geom name="table_leg_px_py" type="box" pos=" 0.66  0.36 -0.32" size="0.03 0.03 0.28" material="table"/>
      <geom name="table_leg_px_ny" type="box" pos=" 0.66 -0.36 -0.32" size="0.03 0.03 0.28" material="table"/>
      <geom name="table_leg_nx_py" type="box" pos="-0.26  0.36 -0.32" size="0.03 0.03 0.28" material="table"/>
      <geom name="table_leg_nx_ny" type="box" pos="-0.26 -0.36 -0.32" size="0.03 0.03 0.28" material="table"/>
    </body>
  </worldbody>
</mujoco>
